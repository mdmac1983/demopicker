<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_label"
        android:theme="@style/Theme.Demopicker"
        android:supportsRtl="true">

        <activity
            android:name="apk.oriommd.demopicker.MainActivity"
            android:exported="true"
            android:label="@string/app_label"
            android:theme="@style/Theme.Demopicker" />

        <activity
            android:name="apk.oriommd.demopicker.BlankActivity"
            android:exported="false"
            android:theme="@style/Theme.Demopicker.Blank" />

        <!--
          Launcher entry points live here, not on MainActivity, so the
          visible app name can be switched at runtime: exactly one of
          these aliases is enabled at a time (see MainActivity's
          long-press-back "App name" picker), and the launcher shows
          whichever one is currently enabled. All target the same
          MainActivity and share the same icon.
        -->
        <activity-alias
            android:name="apk.oriommd.demopicker.alias.AliasSettings"
            android:targetActivity="apk.oriommd.demopicker.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/alias_label_settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="apk.oriommd.demopicker.alias.AliasSystem"
            android:targetActivity="apk.oriommd.demopicker.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/alias_label_system">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="apk.oriommd.demopicker.alias.AliasTools"
            android:targetActivity="apk.oriommd.demopicker.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/alias_label_tools">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="apk.oriommd.demopicker.alias.AliasFiles"
            android:targetActivity="apk.oriommd.demopicker.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/alias_label_files">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="apk.oriommd.demopicker.alias.AliasCalendar"
            android:targetActivity="apk.oriommd.demopicker.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/alias_label_calendar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="apk.oriommd.demopicker.alias.AliasCalculator"
            android:targetActivity="apk.oriommd.demopicker.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/alias_label_calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="apk.oriommd.demopicker.alias.AliasNotes"
            android:targetActivity="apk.oriommd.demopicker.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/alias_label_notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="apk.oriommd.demopicker.alias.AliasClock"
            android:targetActivity="apk.oriommd.demopicker.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/alias_label_clock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
